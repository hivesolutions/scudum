#!/bin/sh

### BEGIN INIT INFO
# Provides:            firstboot
# Required-Start:      mountvirtfs
# Should-Start:
# Required-Stop:
# Should-Stop:
# Default-Start:       S
# Default-Stop:
# Short-Description:   Generates the missing linker cache and hardware database.
# Description:         Generates the dynamic linker cache and the udev
#                      hardware database in case they are missing, as
#                      a cross compiled root can not generate them on build.
### END INIT INFO

. /lib/lsb/init-functions

case "${1}" in
    start)
        # the linker cache can only be generated by the ldconfig of the
        # target, and a transient root loses it on shutdown, so it's
        # generated whenever it's missing (as in a cross compiled root)
        if [ ! -f /etc/ld.so.cache ]; then
            log_info_msg "Generating linker cache (/etc/ld.so.cache)..."
            /sbin/ldconfig
            evaluate_retval
        fi

        # generates the hardware database before udev is started so
        # that the coldplugged devices get the database properties
        if [ ! -f /etc/udev/hwdb.bin ]; then
            log_info_msg "Generating hardware database (/etc/udev/hwdb.bin)..."
            /sbin/udevadm hwdb --update
            evaluate_retval
        fi
        ;;

    *)
        echo "Usage: ${0} {start}"
        exit 1
        ;;
esac

exit 0
